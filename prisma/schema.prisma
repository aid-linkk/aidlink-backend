// ─── Pledge System ───────────────────────────────────────────────────────────

enum PledgeType {
  ONE_OFF
  RECURRING
}

enum PledgeCadence {
  WEEKLY
  MONTHLY
}

enum PledgeStatus {
  ACTIVE
  PAUSED
  CANCELLED
  FAILED
  COMPLETED
}

enum PledgeAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

model Pledge {
  id             String        @id @default(uuid())
  donorId        String
  campaignId     String?
  amount         Decimal
  currency       String        @default("USD")
  type           PledgeType
  cadence        PledgeCadence?
  startDate      DateTime
  nextRunAt      DateTime?
  endDate        DateTime?
  status         PledgeStatus  @default(ACTIVE)
  idempotencyKey String?       @unique
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  donor     User       @relation(fields: [donorId], references: [id])
  campaign  Campaign?  @relation(fields: [campaignId], references: [id])
  attempts  PledgeAttempt[]

  @@index([donorId])
  @@index([status, nextRunAt])
  @@map("pledges")
}

model PledgeAttempt {
  id               String              @id @default(uuid())
  pledgeId         String
  attemptAt        DateTime            @default(now())
  status           PledgeAttemptStatus @default(PENDING)
  providerReference String?
  // The billing-cycle window (captured from Pledge.nextRunAt at the start of
  // the processing tick, before any attempt is recorded) this attempt
  // belongs to. Used to scope retry counts to the current cycle instead of
  // counting all-time attempts, and to audit which cycle a SUCCESS row
  // completed. Nullable so existing rows are unaffected.
  billingCycleAt   DateTime?
  failureReason    String?
  retryCount       Int                 @default(0)
  metadata         Json?
  createdAt        DateTime            @default(now())

  pledge Pledge @relation(fields: [pledgeId], references: [id])

  @@index([pledgeId])
  @@index([status])
  // A SUCCESS attempt with providerReference = idempotencyKey for a given
  // (pledgeId, billingCycleAt) marks that cycle as completed — this partial
  // covering index makes the restart-safety lookup in the worker cheap.
  @@index([pledgeId, providerReference, status])
  @@map("pledge_attempts")
}

