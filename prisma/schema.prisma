// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // "metrics" exposes connection-pool gauges via prisma.$metrics, consumed by
  // /health/db and /api/v1/admin/database/metrics.
  previewFeatures = ["postgresqlExtensions", "metrics"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum Role {
  ADMIN
  ORGANIZATION
  DONOR
  BENEFICIARY
  VERIFIER
  AUDITOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  REJECTED
  DELETED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  username            String?    @unique
  passwordHash        String?
  walletAddress       String?    @unique
  role                Role       @default(DONOR)
  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerified       Boolean    @default(false)
  verificationToken   String?    @unique
  verificationExpiry  DateTime?
  failedVerifyAttempts Int       @default(0)
  lastLogin           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  sessions                Session[]
  organizations           Organization?
  beneficiary             Beneficiary?
  donations               Donation[]
  campaigns               Campaign[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  kycSubmissions          KYCSubmission[]
  pledges                 Pledge[]
  donorCredits            DonorCredit[]
  taxReceipts             TaxReceipt[]
  receiptBatchJobs        ReceiptBatchJob[]
  emailPreference         EmailPreference?
  emailVerificationTokens EmailVerificationToken[]
  verificationLogs        VerificationLog[]
  adminNotificationPref   AdminNotificationPreference?
  privacySettings         PrivacySettings?

  @@index([email])
  @@index([walletAddress])
  @@index([role])
  @@index([status])
}

model VerificationLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // 'SENT' | 'VERIFIED' | 'EXPIRED' | 'RESENT' | 'FAILED'
  tokenHash  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ============================================
// ORGANIZATION
// ============================================

enum OrganizationStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum OrganizationVerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
  MORE_INFO_REQUESTED
}

enum BankAccountVerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  ARCHIVED
}

model Organization {
  id                 String             @id @default(cuid())
  userId             String             @unique
  name               String
  email              String?
  country            String?
  description        String?
  website            String?
  logo               String?
  registrationNumber String?
  taxId              String?
  representativeContact Json?
  address            Json?
  legalDocuments     Json?
  supportingMetadata Json?
  status             OrganizationStatus @default(PENDING)
  verificationStatus OrganizationVerificationStatus @default(UNVERIFIED)
  verificationRequestedAt DateTime?
  verifiedAt         DateTime?
  verificationNotes  String?            @db.Text
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  bankAccounts     BankAccount[]
  verificationEvents OrganizationVerificationEvent[]
  taxReceipts      TaxReceipt[]
  receiptBatchJobs ReceiptBatchJob[]

  @@index([userId])
  @@index([status])
  @@index([verificationStatus])
  @@index([deletedAt])
}

model BankAccount {
  id                 String                        @id @default(cuid())
  organizationId     String
  accountHolderName  String?
  bankName           String
  accountNumber      String
  routingNumber      String
  routingCode        String?
  iban               String?
  accountType        String
  currency           String                        @default("USD")
  branchCode         String?
  country            String?
  verificationStatus BankAccountVerificationStatus @default(UNVERIFIED)
  verificationNotes  String?                       @db.Text
  verifiedAt         DateTime?
  archivedAt         DateTime?
  isPrimary          Boolean                       @default(false)
  metadata           Json?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([verificationStatus])
  @@index([archivedAt])
}

model OrganizationVerificationEvent {
  id             String                       @id @default(cuid())
  organizationId String
  actorId        String?
  status         OrganizationVerificationStatus
  reason         String?                      @db.Text
  evidence       Json?
  metadata       Json?
  createdAt      DateTime                     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// CAMPAIGN
// ============================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  SUSPENDED
  PENDING_REVIEW
}

model Campaign {
  id                 String         @id @default(cuid())
  organizationId     String
  userId             String
  title              String
  description        String         @db.Text
  imageUrl           String?
  targetAmount       Decimal        @db.Decimal(20, 8)
  currentAmount      Decimal        @default(0) @db.Decimal(20, 8)
  startDate          DateTime
  endDate            DateTime?
  status             CampaignStatus @default(DRAFT)
  blockchainTxHash   String?        @unique
  contractAddress    String?
  suspendedAt        DateTime?
  suspensionMetadata Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
donations     Donation[]
  beneficiaries BeneficiaryAssignment[]
  distributions Distribution[]
  milestones    Milestone[]
  multipliers   Multiplier[]
  matchedFunds  MatchedFund[]
  suspensions   Suspension[]
  appeals       Appeal[]
  fraudReports  FraudReport[]
  pledges       Pledge[]
  hourlyStats   CampaignHourlyStat[]
  monthlyStats  CampaignMonthlyStat[]
  trendings     CampaignTrending[]

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model Milestone {
  id                  String                       @id @default(cuid())
  campaignId          String
  title               String
  description         String                       @db.Text
  targetAmount        Decimal                      @db.Decimal(20, 8)
  achieved            Boolean                      @default(false)
  achievedAt          DateTime?
  order               Int
  verificationStatus  MilestoneVerificationStatus  @default(PENDING_SUBMISSION)
  currentSubmissionId String?
  currentReviewId     String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  campaign    Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submissions MilestoneSubmission[]

  @@index([campaignId])
  @@index([verificationStatus])
}

// ============================================
// MILESTONE VERIFICATION
// ============================================

enum MilestoneSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum MilestoneVerificationStatus {
  PENDING_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ARCHIVED
}

enum MilestoneVerificationEvent {
  SUBMITTED
  REVIEW_STARTED
  REVISION_REQUESTED
  APPROVED
  REJECTED
  RESUBMITTED
}

model MilestoneSubmission {
  id              String                    @id @default(cuid())
  campaignId      String
  milestoneId     String
  organizationId  String
  description     String                    @db.Text
  evidenceUrls    String[]
  metricsData     Json                      @default("{}")
  status          MilestoneSubmissionStatus @default(DRAFT)
  submittedAt     DateTime?
  submissionNotes String?                   @db.Text
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  milestone Milestone                        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  reviews   MilestoneReview[]
  history   MilestoneVerificationHistory[]

  @@index([milestoneId])
  @@index([campaignId])
  @@index([organizationId])
  @@index([status])
  @@index([submittedAt])
}

model MilestoneReview {
  id               String         @id @default(cuid())
  submissionId     String
  verifierId       String
  decision         ReviewDecision
  reason           String?        @db.Text
  verifierNotes    String?        @db.Text
  metricsConfirmed Json?
  impactSummary    String?        @db.Text
  reviewedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  submission MilestoneSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([verifierId])
  @@index([decision])
  @@index([reviewedAt])
}

model MilestoneVerificationHistory {
  id           String                     @id @default(cuid())
  submissionId String
  event        MilestoneVerificationEvent
  actor        String
  metadata     Json?
  timestamp    DateTime                   @default(now())

  submission MilestoneSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([event])
  @@index([timestamp])
}

// ============================================
// DONATION
// ============================================

enum DonationStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Donation {
  id                 String         @id @default(cuid())
  campaignId         String
  userId             String?
  amount             Decimal        @db.Decimal(20, 8)
  currency           String         @default("XLM")
  status             DonationStatus @default(PENDING)
  blockchainTxHash   String?        @unique
  fromWallet         String?
  toWallet           String?
  memo               String?
  isAnonymous        Boolean        @default(false)
  donorMessage       String?        @db.Text
  receiptGeneratedAt DateTime?
  revealedAt         DateTime?
  groupId            String?
  retentionPolicy    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  taxReceipt  TaxReceipt?
  matchedFund MatchedFund?

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([blockchainTxHash])
  @@index([createdAt])
}

// ============================================
// MATCHED FUNDS
// ============================================

enum MultiplierType {
  MILESTONE
  CORPORATE
  CAMPAIGN_WIDE
}

// A multiplier rule that matches donor contributions at a fixed factor, within
// campaign-level (matchCap) and per-donation (perDonationCap) limits. matchedTotal
// is the authoritative running total consumed against matchCap; it is only ever
// advanced through the locked conditional update in MatchedFundAllocationService,
// never by re-aggregating MatchedFund rows, so it stays correct under concurrent
// donation confirmations.
model Multiplier {
  id             String         @id @default(cuid())
  campaignId     String
  type           MultiplierType
  multiplier     Decimal        @db.Decimal(6, 2)
  matchCap       Decimal?       @db.Decimal(20, 8)
  perDonationCap Decimal?       @db.Decimal(20, 8)
  matchedTotal   Decimal        @default(0) @db.Decimal(20, 8)
  startAt        DateTime?
  endAt          DateTime?
  milestoneId    String?
  metadata       Json?
  active         Boolean        @default(true)
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  matchedFunds MatchedFund[]

  @@index([campaignId])
  @@index([campaignId, active])
  @@index([milestoneId])
}

// One row per donation that received a match. donationId is unique so a
// donation can be allocated at most once, which keeps the allocation path
// idempotent under retries or a competing confirmation for the same donation.
model MatchedFund {
  id            String   @id @default(cuid())
  donationId    String   @unique
  campaignId    String
  multiplierId  String
  matcherId     String?
  donorAmount   Decimal  @db.Decimal(20, 8)
  matchedAmount Decimal  @db.Decimal(20, 8)
  totalAmount   Decimal  @db.Decimal(20, 8)
  createdAt     DateTime @default(now())

  donation   Donation   @relation(fields: [donationId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  multiplier Multiplier @relation(fields: [multiplierId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([multiplierId])
}

// ============================================
// BENEFICIARY
// ============================================

enum BeneficiaryStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  ACTIVE
}

model Beneficiary {
  id               String            @id @default(cuid())
  userId           String            @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           String
  nationality      String
  idDocumentType   String
  idDocumentNumber String
  phoneNumber      String
  address          String            @db.Text
  city             String
  country          String
  coordinates      String? // JSON: {lat, lng}
  familySize       Int               @default(1)
  needsAssessment  String?           @db.Text
  needsCategory    String?
  status           BeneficiaryStatus @default(PENDING)
  verifiedAt       DateTime?
  verifiedBy       String?
  riskScore        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments    BeneficiaryAssignment[]
  distributions  Distribution[]
  kycSubmissions KYCSubmission[]

  @@index([userId])
  @@index([status])
  @@index([country])
  @@index([city])
  @@index([riskScore])
  @@index([needsCategory])
  @@index([familySize])
  @@index([dateOfBirth])
  @@index([country, city])
  @@index([status, country])
  @@unique([idDocumentNumber, nationality])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([idDocumentNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phoneNumber(ops: raw("gin_trgm_ops"))], type: Gin)
}

model BeneficiaryAssignment {
  id              String   @id @default(cuid())
  campaignId      String
  beneficiaryId   String
  assignedAmount  Decimal  @default(0) @db.Decimal(20, 8)
  allocatedAmount Decimal  @default(0) @db.Decimal(20, 8)
  priority        Int      @default(0)
  notes           String?  @db.Text
  assignedAt      DateTime @default(now())
  assignedBy      String?

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, beneficiaryId])
  @@index([campaignId])
  @@index([beneficiaryId])
}

// ============================================
// DISTRIBUTION
// ============================================

enum DistributionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum DistributionMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CRYPTO
  VOUCHER
  IN_KIND
}

model Distribution {
  id               String             @id @default(cuid())
  campaignId       String
  beneficiaryId    String
  amount           Decimal            @db.Decimal(20, 8)
  currency         String             @default("XLM")
  method           DistributionMethod
  status           DistributionStatus @default(PENDING)
  blockchainTxHash String?            @unique
  transactionRef   String?
  proofDocumentUrl String?
  notes            String?            @db.Text
  distributedAt    DateTime?
  distributedBy    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([beneficiaryId])
  @@index([status])
  @@index([distributedAt])
}

// ============================================
// KYC & VERIFICATION
// ============================================

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model KYCSubmission {
  id                String    @id @default(cuid())
  userId            String
  beneficiaryId     String?
  submissionType    String // INDIVIDUAL, ORGANIZATION
  status            KYCStatus @default(PENDING)
  documentType      String
  documentUrl       String
  selfieUrl         String?
  additionalDocs    Json?
  reviewNotes       String?   @db.Text
  reviewedBy        String?
  reviewedAt        DateTime?
  expiresAt         DateTime?
  fraudScore        Int       @default(0)
  fraudScoreFloat   Float?    // Full-precision calibrated probability (0-1)
  // Calibrated probability from a shadow (candidate) FraudModelVersion, scored alongside
  // the active version for A/B comparison. Not used for any KYC decision.
  shadowScore       Float?
  fraudSignals      Json?     // Array of { signal, severity, detail }
  fraudReason       String?   @db.Text
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  documentHistory KYCDocumentHistory[]

  @@index([userId])
  @@index([beneficiaryId])
  @@index([status])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([deviceFingerprint])
}

// Immutable audit trail of every KYC document replacement.
// One row is written each time uploadKycDocument overwrites an existing URL.
// Rows are append-only and never updated or deleted.
model KYCDocumentHistory {
  id            String   @id @default(cuid())
  submissionId  String
  // Which field was replaced: "document" | "selfie"
  field         String
  // The URL that was in place before this upload
  replacedUrl   String
  // The URL that replaced it
  newUrl        String
  // User who performed the upload
  uploadedBy    String
  replacedAt    DateTime @default(now())

  submission KYCSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([field])
  @@index([replacedAt])
}

// ============================================
// NOTIFICATION
// ============================================

enum NotificationType {
  DONATION_RECEIVED
  CAMPAIGN_UPDATE
  DISTRIBUTION_SENT
  KYC_APPROVED
  KYC_REJECTED
  ORGANIZATION_PROFILE_UPDATED
  ORGANIZATION_VERIFICATION_SUBMITTED
  ORGANIZATION_VERIFICATION_APPROVED
  ORGANIZATION_VERIFICATION_REJECTED
  ORGANIZATION_VERIFICATION_INFO_REQUESTED
  BANK_ACCOUNT_ADDED
  BANK_ACCOUNT_REVIEW_REQUIRED
  SYSTEM_ALERT
  SECURITY_ALERT
  CAMPAIGN_SUSPENDED
  CAMPAIGN_REINSTATED
  APPEAL_UPDATE
  MILESTONE_SUBMISSION_RECEIVED
  MILESTONE_APPROVED
  MILESTONE_REJECTED
  MILESTONE_REVISION_REQUESTED
  REFUND_FAILED
  REFUND_RECOVERED
  DISTRIBUTION_FAILED
  CAMPAIGN_SETTLEMENT
  DONOR_CREDIT_ISSUED
  PLEDGE_PAYMENT_FAILED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED_TRANSIENT
  FAILED_PERMANENT
}

model Notification {
  id             String                     @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  message        String                     @db.Text
  status         NotificationStatus         @default(UNREAD)
  deliveryStatus NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0)
  lastAttemptAt  DateTime?
  lastError      String?                    @db.Text
  metadata       Json?
  sentVia        String[]                   @default([])
  readAt         DateTime?
  createdAt      DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([deliveryStatus])
}

// ============================================
// EMAIL PREFERENCES & TEMPLATES
// ============================================

model EmailPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  categories        Json
  allEmailsDisabled Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── User privacy settings (issue #13: user dashboard endpoints) ─────────────

enum ProfileVisibility {
  /// Profile (display name, campaigns/donations marked shareable) is visible to anyone.
  PUBLIC
  /// Profile is visible only to organizations the user has donated to or is affiliated with.
  DONORS_ONLY
  /// Profile is visible only to the account owner and platform admins.
  PRIVATE
}

model PrivacySettings {
  id                       String            @id @default(cuid())
  userId                   String            @unique
  profileVisibility        ProfileVisibility @default(PRIVATE)
  /// Whether this user's donation history can be shown on their public profile.
  showDonationHistory      Boolean           @default(false)
  /// Whether this user's real name (vs. username) is shown publicly.
  showRealName             Boolean           @default(false)
  /// Default value for `isAnonymous` pre-filled on new donations for this user.
  defaultDonationAnonymous Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Admin notification preferences ──────────────────────────────────────────

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
}

enum NotificationFrequency {
  IMMEDIATE
  DAILY_DIGEST
  WEEKLY
}

enum AdminNotificationTypePreference {
  ALL
  ALERTS_ONLY
  NONE
}

/// Per-admin granular control over which notifications are received, on which
/// channels, at what frequency, and scoped to which entities.
model AdminNotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  /// Per-type overrides. Keys are NotificationType values; values are
  /// AdminNotificationTypePreference. Missing keys fall back to ALL.
  typePreferences Json @default("{}")

  /// Channels the admin wants notifications delivered on.
  channels NotificationChannel[] @default([EMAIL, IN_APP])

  /// Whether to batch or deliver immediately.
  frequency NotificationFrequency @default(IMMEDIATE)

  /// Optional whitelist of campaign IDs. Empty array = no filter (all campaigns).
  campaignFilter String[] @default([])

  /// Optional whitelist of user role strings (e.g. ["BENEFICIARY", "ORGANIZATION"]).
  /// Empty array = no filter (all roles).
  userRoleFilter String[] @default([])

  /// Mute everything except SECURITY_ALERT.
  muteAll Boolean @default(false)

  /// Quiet hours (UTC 24h "HH:MM"). Immediate notifications are deferred until end.
  quietHoursStart String?
  quietHoursEnd   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Staging table for DAILY_DIGEST and WEEKLY batched delivery.
model NotificationDigestQueue {
  id             String                @id @default(cuid())
  userId         String
  notificationId String
  frequency      NotificationFrequency
  scheduledFor   DateTime
  sent           Boolean               @default(false)
  sentAt         DateTime?
  createdAt      DateTime              @default(now())

  @@index([userId, sent])
  @@index([scheduledFor, sent])
}

model EmailTemplate {
  id              String   @id @default(cuid())
  name            String
  version         String
  notificationId  String?
  description     String?
  renderedAt      DateTime @default(now())
  metadata        Json?

  @@index([name])
  @@index([version])
  @@index([renderedAt])
}

// ============================================
// BLOCKCHAIN
// ============================================

enum TransactionType {
  DONATION
  DISTRIBUTION
  CONTRACT_DEPLOYMENT
  CONTRACT_CALL
  FEE_PAYMENT
}

model BlockchainTransaction {
  id              String          @id @default(cuid())
  txHash          String          @unique
  type            TransactionType
  fromAddress     String?
  toAddress       String?
  amount          Decimal?        @db.Decimal(20, 8)
  currency        String?
  contractAddress String?
  functionName    String?
  parameters      Json?
  /// PENDING | CONFIRMED | FAILED | ORPHANED
  /// ORPHANED rows were on a minority fork and have been superseded by the
  /// canonical ledger version. They are retained for audit purposes.
  status          String          @default("PENDING")
  blockNumber     BigInt?
  ledgerHash      String?         // hash of the ledger that contained this tx
  timestamp       DateTime?
  indexed         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([txHash])
  @@index([type])
  @@index([status])
  @@index([indexed])
  @@index([blockNumber])
  @@index([ledgerHash])
}

// ============================================
// INDEXER
// ============================================

/// Persists the indexer's cursor so that on restart it resumes from the
/// last successfully processed ledger instead of re-scanning from tip-1000.
/// There is exactly one row in this table (id = "singleton").
model IndexerCheckpoint {
  id            String   @id @default("singleton")
  /// Ledger sequence number of the last successfully processed ledger
  lastSequence  Int      @default(0)
  /// Hash of the last successfully processed ledger (for reorg detection)
  lastHash      String   @default("")
  updatedAt     DateTime @updatedAt
}

model ContractEvent {
  id              String    @id @default(cuid())
  txHash          String
  contractAddress String
  eventName       String
  parameters      Json
  blockNumber     BigInt?
  timestamp       DateTime?
  processed       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([txHash])
  @@index([contractAddress])
  @@index([eventName])
  @@index([processed])
}

