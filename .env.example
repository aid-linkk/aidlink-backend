# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DATABASE_URL="postgresql://aidlink:aidlink_password@localhost:5432/aidlink?schema=public"

# Connection Pool (all optional - see docs/DATABASE_POOLING.md)
# Per-process pool size. Leave unset to auto-size from CPU count and the budget below.
# DB_POOL_MAX=
# Number of app processes/replicas sharing this PostgreSQL server
DB_POOL_INSTANCES=1
# Connections the app fleet may use in total (PostgreSQL max_connections minus headroom)
DB_SERVER_CONNECTION_BUDGET=80
# Seconds a query waits for a free pooled connection before failing with P2024
DB_POOL_TIMEOUT_SECONDS=10
# Seconds to wait while establishing a new connection
DB_CONNECT_TIMEOUT_SECONDS=10
# Seconds a single statement may hold a connection (0 disables)
DB_SOCKET_TIMEOUT_SECONDS=0
# Startup connect retries with exponential backoff
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_BASE_DELAY_MS=500

# Connection Monitoring & Query Metrics
# Pool sampling interval in ms (0 disables the sampler)
DB_MONITOR_INTERVAL_MS=60000
# Warn once busy connections reach this fraction of the pool limit
DB_POOL_SATURATION_THRESHOLD=0.8
# Queries slower than this (ms) are counted and logged
DB_SLOW_QUERY_THRESHOLD_MS=500
DB_LOG_SLOW_QUERIES=true
# Client-side abort for runaway queries in ms (0 disables)
DB_QUERY_TIMEOUT_MS=0

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Wallet Authentication
WALLET_AUTH_SECRET=your_wallet_auth_secret_change_in_production
# Domain embedded in signed wallet-auth challenges to prevent cross-service
# signature replay (issue #170). Falls back to CORS_ORIGIN if unset.
APP_DOMAIN=aidlink.org
WALLET_AUTH_CHALLENGE_TTL_SECONDS=300
WALLET_AUTH_MAX_FAILED_ATTEMPTS=5
WALLET_AUTH_FAILED_ATTEMPT_WINDOW_SECONDS=900

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@aidlink.org
EMAIL_QUEUE_ENABLED=false
EMAIL_LOGO_URL=https://aidlink.org/logo.png
SUPPORT_EMAIL=support@aidlink.org
APP_URL=http://localhost:3000

# Soroban/Stellar Configuration
SOROBAN_NETWORK_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Blockchain Indexer Configuration
# Horizon REST API base URL (testnet default; use https://horizon.stellar.org for mainnet)
HORIZON_URL=https://horizon-testnet.stellar.org
# Maximum ledgers to process per tick when catching up after a gap (default: 50)
SOROBAN_INDEXER_BATCH_SIZE=50
# Maximum Horizon/Soroban-RPC requests per second — token-bucket enforced (default: 5)
SOROBAN_INDEXER_RPS_LIMIT=5
# Milliseconds between normal (non-catch-up) loop ticks (default: 10000)
SOROBAN_INDEXER_POLL_INTERVAL_MS=10000
# Milliseconds to wait after a fatal indexer error before retrying (default: 30000)
SOROBAN_INDEXER_ERROR_BACKOFF_MS=30000

# Pledge Worker Payment Provider (issue #171)
# One of: stripe | stellar | mock (mock must never be used in production)
PAYMENT_PROVIDER=mock
PLEDGE_MAX_RETRIES=3
PLEDGE_REMINDER_WINDOW_DAYS=3
PLEDGE_WORKER_ENABLED=false

# Required when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=

# Required when PAYMENT_PROVIDER=stellar — secret key for the campaign
# escrow wallet that submits/receives pledge payment operations
STELLAR_ESCROW_SECRET_KEY=
CONTRACT_ADDRESS=your_contract_address

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs

# BullMQ Configuration
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=

# WebSocket Configuration
WS_PORT=3001

# Monitoring
HEALTH_CHECK_INTERVAL=30000

# Campaign Moderation
# Toggle automatic suspension. Admin manual suspend/reinstate always works.
MODERATION_AUTO_SUSPEND_ENABLED=false
# Suspend campaigns whose verification score stays below the threshold for the grace period.
MODERATION_VERIFICATION_SCORE_THRESHOLD=40
MODERATION_VERIFICATION_GRACE_DAYS=7
# Suspend after N independent fraud reports within the rolling window (hours).
MODERATION_FRAUD_REPORT_THRESHOLD=3
MODERATION_FRAUD_REPORT_WINDOW_HOURS=24
# Notify donors when a campaign is suspended for fraud (set to false to disable).
MODERATION_NOTIFY_DONORS_ON_FRAUD=true

# KYC Fraud Detection
# Velocity window and submission limits
KYC_FRAUD_VELOCITY_WINDOW_MINUTES=60
KYC_FRAUD_VELOCITY_MAX_PER_IP=5
KYC_FRAUD_VELOCITY_MAX_PER_USER=3
# Geographic anomaly: max plausible speed in km/h (commercial flight ~900)
KYC_FRAUD_GEO_MAX_SPEED_KMH=900
# Number of prior submissions to examine for multi-hop impossible travel detection (default: 5)
GEO_ANOMALY_LOOKBACK=5
# Score threshold to enqueue FRAUD_DETECTION job
KYC_FRAUD_HIGH_RISK_THRESHOLD=50
# Signal weights (integers, loosely sum to 100)
KYC_FRAUD_WEIGHT_DOC_REUSE=30
KYC_FRAUD_WEIGHT_GEO=20
KYC_FRAUD_WEIGHT_VELOCITY=25
KYC_FRAUD_WEIGHT_DEVICE=15
KYC_FRAUD_WEIGHT_THIRD_PARTY=10
# Third-party fraud service (optional, disabled by default)
KYC_FRAUD_THIRD_PARTY_ENABLED=false
KYC_FRAUD_THIRD_PARTY_API_URL=
KYC_FRAUD_THIRD_PARTY_API_KEY=
KYC_FRAUD_THIRD_PARTY_TIMEOUT_MS=5000

# Matched Fund Verification
# Feature flag: set to false to disable the worker entirely
MATCHED_FUND_VERIFICATION_ENABLED=true
# Cron for full verification (all multipliers) — default daily at 02:30 UTC
MATCHED_FUND_VERIFICATION_FULL_CRON="30 2 * * *"
# Cron for sample verification — default hourly at :45
MATCHED_FUND_VERIFICATION_SAMPLE_CRON="45 * * * *"
# Percentage of Multiplier rows to sample in SAMPLE mode (1–100)
MATCHED_FUND_VERIFICATION_SAMPLE_PCT=10
# Minimum absolute difference to treat as an inconsistency (8 d.p. noise floor)
MATCHED_FUND_VERIFICATION_THRESHOLD=0.00000001
# Alert if this fraction of checked multipliers are inconsistent (0.05 = 5%)
MATCHED_FUND_VERIFICATION_SYSTEMIC_THRESHOLD=0.05
# Alert if any single multiplier discrepancy exceeds this amount
MATCHED_FUND_VERIFICATION_LARGE_AMOUNT=1000
# Max ms the repair transaction may hold a FOR UPDATE lock per multiplier
MATCHED_FUND_VERIFICATION_REPAIR_TIMEOUT_MS=5000



# Fraud concept drift monitoring (recalibration worker only)
FRAUD_DRIFT_ENABLED=true
FRAUD_DRIFT_METHODS=ks,psi,chiSquared
FRAUD_DRIFT_SIGNIFICANCE_LEVEL=0.01
FRAUD_DRIFT_PSI_THRESHOLD=0.2
FRAUD_DRIFT_MIN_SAMPLES=30
FRAUD_DRIFT_HISTOGRAM_BINS=10
FRAUD_DRIFT_BASELINE_WINDOW_HOURS=720
FRAUD_DRIFT_CURRENT_WINDOW_HOURS=168
FRAUD_DRIFT_DETECTION_INTERVAL_MINUTES=60
